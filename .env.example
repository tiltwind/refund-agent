# 复制为 .env 后填入真实值：cp .env.example .env
# .env 含密钥，不提交 git；本文件只放占位符，可提交。

# ---- 模型接入 ----
# 两家任配一个。都配了默认走 Anthropic；要切换就设 REFUND_AGENT_PROVIDER，
# 别靠删 key 切 —— 完整解析规则见 llm/chat.py 的模块 docstring。
# REFUND_AGENT_PROVIDER="anthropic"   # anthropic | openai

# Anthropic：官方端点留空即可；走兼容网关（如 DeepSeek）时填对应地址
ANTHROPIC_BASE_URL="https://api.anthropic.com"
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"   # 留空则用 agent/v1/meta.yaml 里的默认值

# OpenAI 及其兼容网关（DeepSeek / Qwen / vLLM / one-api …）
# 走这条路时 OPENAI_MODEL 必填：各家网关的模型名不同，代码不猜默认值。
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY=""
OPENAI_MODEL=""
# OPENAI_REWRITE_MODEL=""             # 查询改写用的小模型；不填则跟主模型走同一个

# 查询改写要模型吐结构化结果，而这是兼容网关最容易缺的能力。OpenAI 侧默认走
# function_calling（比默认的 json_schema 通用），仍报错时再动下面两个：
#   REFUND_AGENT_REWRITE_STRUCTURED="function_calling"   # 或 json_schema / json_mode
#   REFUND_AGENT_REWRITE_REASONING="none"                # 思考模式与 tool_choice 冲突时关掉
# DeepSeek 实测可用组合：function_calling + REWRITE_REASONING="none"。
# 都不行就 REFUND_AGENT_REWRITE="off"，检索照跑，只是排序质量掉一档（见 rewrite.py）。

# ---- 评测：LLM judge ----
# Context Recall / Context Relevance 的判定模型（rag/experiments/*/judge.py）。
# 只在评测脚本里用，不在线上链路上，所以该配一个比主模型更强的档次：judge 判错，
# 指标就是噪声。不配就跟主模型走同一个 —— 那是自己评自己，跑批时会打一行警告。
# OPENAI_JUDGE_MODEL=""
# ANTHROPIC_JUDGE_MODEL=""
# REFUND_AGENT_JUDGE_MODEL=""         # 跨供应商的强制覆盖，可带 openai:/anthropic: 前缀

# judge 挂在另一个网关上时端点和 key 也单独配，不填则跟着通用的那两个走。
# 换端点通常就得换 key —— 两个网关不会认同一把。
# OPENAI_JUDGE_BASE_URL=""
# OPENAI_JUDGE_API_KEY=""
# ANTHROPIC_JUDGE_BASE_URL=""
# ANTHROPIC_JUDGE_API_KEY=""

# judge 也要结构化输出，坑与查询改写那边相同（见上）。区别在于这里更值得保留思考：
#   REFUND_AGENT_JUDGE_STRUCTURED="json_mode"   # thinking + 结构化能共存的那一档
#   REFUND_AGENT_JUDGE_REASONING="none"         # 或者反过来，关思考、走 function_calling
# DeepSeek 实测：json_mode 可以开着思考；function_calling 必须配 REASONING="none"。

# ---- 可观测：Langfuse ----
# 两个 key 留空 = 不上报，链路照常跑（services/telemetry.py 静默降级）。
# BASE_URL 指自建实例；用 Langfuse Cloud 就留空走默认端点。
# 注意 v2/v3 SDK 只认 LANGFUSE_HOST 这个名字，telemetry.py 两个都读，先 BASE_URL。
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL="http://localhost:3000"
# 线上进程设 production；离线脚本设 eval。该值进入 Langfuse 的一等 environment 字段。
LANGFUSE_TRACING_ENVIRONMENT="eval"

# 上报 trace 时 customer_id 的哈希盐（2-design 5.2/5.4）。换盐会让新旧 trace 的
# user_id 对不上，属于配置不是随机值；线上从密钥管理取，别用代码里的默认值。
# REFUND_AGENT_HASH_SALT=""

# ---- 检索链路（可选）----
# MILVUS_URI="http://localhost:19530"
# MILVUS_COLLECTION="refund_policy_chunks"
# REFUND_AGENT_RAG_TRACE="on"
# REFUND_AGENT_RERANK="on"
# 跨供应商的强制覆盖，优先级高于 ANTHROPIC_MODEL / OPENAI_MODEL。
# 可带前缀指定供应商：REFUND_AGENT_MODEL="openai:deepseek-chat"
# REFUND_AGENT_MODEL="claude-sonnet-5"
# REFUND_AGENT_REWRITE_MODEL=""
